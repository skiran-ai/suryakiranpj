# Django Security & Core Settings
DJANGO_SECRET_KEY=your-production-django-secret-key-here-min-50-characters
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,your-service.onrender.com

# CORS & CSRF Origins Configuration
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOW_ALL_ORIGINS=False

# Database Configuration (PostgreSQL in production; uncomment to use PostgreSQL)
# Example: postgres://username:password@hostname:5432/databasename
DATABASE_URL=postgres://user:password@localhost:5432/portfolio_db

# Security & SSL (Enable in Production behind HTTPS)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Rate Limiting & Throttling
THROTTLE_ANON_RATE=60/minute
THROTTLE_USER_RATE=120/minute
THROTTLE_CONTACT_RATE=5/hour
THROTTLE_AI_RATE=20/minute

# AI Provider Key (Grounded AI Chatbot)
GEMINI_API_KEY=your-google-gemini-api-key-here

# SMTP Email Configuration (For Contact Form notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=suryakiranpjineesh@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-gmail-app-password
DEFAULT_FROM_EMAIL=suryakiranpjineesh@gmail.com
CONTACT_EMAIL=suryakiranpjineesh@gmail.com
