# Environment Variable Template for Suryakiran Portfolio

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000

# Backend (Django)
DJANGO_SECRET_KEY=your-production-django-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Database (Leave commented for default SQLite development database)
# DATABASE_URL=postgres://user:password@localhost:5432/portfolio_db

# AI Assistant Key (Google Gemini API)
GEMINI_API_KEY=your-gemini-api-key-here

# Email Delivery (Optional)
EMAIL_HOST_USER=suryakiranpjineesh@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
